{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/sense.schema.json",
  "title": "Sense Explanation",
  "type": "object",
  "additionalProperties": false,
  "required": ["entry_id", "lemma", "zh_explanation", "nuance_cn", "reality_vs_acg", "misuse_warning"],
  "properties": {
    "entry_id": { "type": "string", "minLength": 1 },
    "lemma": { "type": "string", "minLength": 1 },
    "zh_explanation": { "type": "string", "minLength": 30, "maxLength": 1200 },
    "nuance_cn": { "type": "string", "minLength": 20, "maxLength": 1000 },
    "reality_vs_acg": { "type": "string", "minLength": 20, "maxLength": 1000 },
    "misuse_warning": { "type": "string", "minLength": 10, "maxLength": 600 }
  }
}
